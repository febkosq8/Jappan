{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "version",
			"type": "promptString",
			"description": "Docker image version",
			"default": "2.0.4"
		}
	],
	"tasks": [
		{
			"label": "Build Docker Image",
			"type": "process",
			"command": "docker",
			"args": ["build", "--tag", "jappan:${input:version}", "."],
			"problemMatcher": []
		},
		{
			"label": "Run Docker Container",
			"type": "process",
			"command": "docker",
			"args": ["run", "--rm", "--name", "jappan", "--env-file", ".env", "jappan:${input:version}"],
			"problemMatcher": []
		}
	]
}
