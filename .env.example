# Required variables
## Credentials
DISCORD_TOKEN="<value>"
DB_URL="<value>"

## Server ports
PORT="8875" # Application listen port (PM2/direct; container port under Docker)
HOST_PORT="8875" # Host machine port mapped to PORT by Docker Compose (Used by Docker)

# Optional variables
## Bot identity and URLs
BOT_NAME="Jappan"
BOT_PFP="https://jappan.febkosq8.me/assets/Profile-FDHZtz5Q.png"
BOT_WEBSITE="https://jappan.febkosq8.me"
BACKEND_URL="https://api-jappan.febkosq8.me"

## Administrator accounts
ADMIN_USER_IDS="<value1>;<value2>"

## Logging and debugging
LOG_TIMESTAMP="false"
PLAYER_DEBUG="false"
PLAYER_HEALTH_DEBUG="false"
ENABLE_EVENTS_DEBUG="<value>"

## Player health check
PLAYER_HEALTH_CHECK_QUERY="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
PLAYER_HEALTH_CHECK_MAX_ATTEMPTS="3"
PLAYER_HEALTH_CHECK_PLAYBACK_MS_TIMEOUT="10000"
PLAYER_HEALTH_CHECK_PLAYBACK_STABILITY_MS_TIMEOUT="5000"
PLAYER_HEALTH_CHECK_GUILD_ID="<value>"
PLAYER_HEALTH_CHECK_CHANNEL_ID="<value>"

## Shutdown behavior
SHUTDOWN_THREASHOLD="3"