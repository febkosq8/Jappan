{
	"name": "jappan",
	"version": "2.1.1",
	"description": "Jappan - Discord Bot",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsup src/index.ts --format esm --external @extractorpack/extractorpack",
		"dev": "tsx watch --include \"./.env\" src/index.ts",
		"extractors:scan": "extractorpack scan",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"migrate:v1tov2": "tsx src/scripts/migrateV1ToV2.ts",
		"prepare": "husky && extractorpack scan",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"lint-staged": {
		"*.{ts,js,json,yml,yaml,md}": "prettier --write"
	},
	"keywords": [
		"discord",
		"bot",
		"music"
	],
	"author": {
		"name": "Febkosq8",
		"email": "contact@febkosq8.me",
		"url": "https://febkosq8.me"
	},
	"license": "CC-BY-NC-4.0",
	"engines": {
		"node": ">=26.13.0"
	},
	"homepage": "https://jappan.febkosq8.me",
	"repository": {
		"type": "git",
		"url": "https://github.com/febkosq8/Jappan.git"
	},
	"packageManager": "pnpm@12.18.0",
	"devDependencies": {
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/node": "26.6.6",
		"@types/swagger-ui-express": "4.1.8",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"tsup": "9.0.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@discord-player/extractor": "7.2.0",
		"@discordjs/voice": "0.19.2",
		"@extractorpack/extractorpack": "0.0.5",
		"better-auth": "1.7.18",
		"bgutils-js": "4.0.3",
		"bufferutil": "4.2.0",
		"colorette": "2.0.20",
		"cors": "2.8.6",
		"cron": "4.4.0",
		"discord-player": "7.2.0",
		"discord-player-youtubei": "3.1.0",
		"discord.js": "14.28.1",
		"dotenv": "18.0.9",
		"express": "5.3.0",
		"googlevideo": "5.0.1",
		"mongoose": "9.12.0",
		"simple-ytdl-core": "1.2.2",
		"socket.io": "4.8.4",
		"swagger-ui-express": "5.0.1",
		"zlib-sync": "0.1.10",
		"zod": "4.6.7"
	}
}
